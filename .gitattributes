# Shell scripts must keep LF endings even when checked out on Windows: the
# ducktests runner bind-mounts the checkout into Linux containers and executes
# them there, where CRLF fails with "$'\r': command not found".
*.sh text eol=lf
mvnw text eol=lf
modules/ducktests/tests/docker/ducker-ignite text eol=lf
modules/ducktests/tests/docker/clean_up.sh text eol=lf

# Windows batch files are only ever run on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
